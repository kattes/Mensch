<?xml version="1.0" encoding="utf-8"?>
<!-- Vordergrund des adaptiven Launcher-Icons: rote Spielfigur mit Lichtspiel
     wie in drawPiece(). Safe-Zone ist der Kreis r=36 um (54,54) – alles
     außerhalb kann vom Launcher beschnitten werden. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Schlagschatten leicht versetzt -->
  <path android:pathData="M 57,57 m -24,0 a 24,24 0 1 0 48,0 a 24,24 0 1 0 -48,0"
      android:fillColor="#40000000" />

  <!-- Figur mit Radial-Gradient (weißer Lichtpunkt o.l., dunkler Rand) -->
  <path android:pathData="M 54,54 m -24,0 a 24,24 0 1 0 48,0 a 24,24 0 1 0 -48,0">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:gradientRadius="28"
          android:centerX="46"
          android:centerY="46">
        <item android:offset="0.0"  android:color="#ffffff" />
        <item android:offset="0.25" android:color="#d62828" />
        <item android:offset="1.0"  android:color="#801818" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Außenkante -->
  <path android:pathData="M 54,54 m -24,0 a 24,24 0 1 0 48,0 a 24,24 0 1 0 -48,0"
      android:strokeColor="#801818"
      android:strokeWidth="1.5"
      android:fillColor="#00000000" />
</vector>
